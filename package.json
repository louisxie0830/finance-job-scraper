{
  "name": "finance-job-scraper",
  "version": "2.0.0",
  "description": "A Node.js application for scraping job listings from finance-related job portals.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "start": "node dist/server.js",
    "dev": "node --watch src/server.ts",
    "run-prod": "pm2-runtime start ecosystem.config.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc"
  },
  "keywords": [
    "finance",
    "job scraper",
    "web scraping",
    "Node.js"
  ],
  "author": "Louis Xie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/louisxie0830/finance-job-scraper.git"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "axios-retry": "^4.5.0",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "p-queue": "^10.0.0",
    "pm2": "^7.1.1",
    "puppeteer": "^25.16.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.19.2",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
